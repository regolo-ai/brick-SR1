{
  "name": "brick-monorepo",
  "private": true,
  "version": "2.2.0",
  "description": "Brick: multimodal LLM routing gateway. Monorepo containing router (Go+Rust), CLI (TypeScript), evals, training, paper.",
  "homepage": "https://github.com/regolo-ai/brick-SR1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regolo-ai/brick-SR1.git"
  },
  "license": "Apache-2.0",
  "workspaces": [
    "apps/cli"
  ],
  "scripts": {
    "build:cli": "npm run --workspace=@regoloai/brick build",
    "test:cli": "npm run --workspace=@regoloai/brick test",
    "lint:cli": "npm run --workspace=@regoloai/brick lint",
    "version:cli": "npm view --workspace=@regoloai/brick"
  },
  "engines": {
    "node": "20 || >=22"
  },
  "overrides": {
    "ejs": "^6.0.1",
    "vite": "6.4.3"
  }
