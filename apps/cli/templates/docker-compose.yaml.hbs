# Generated by brick CLI — do not edit by hand. Run `brick init` to regenerate.
services:
{{#if useLocalClassifier}}
  classifier:
    image: docker.io/regolo/brick-cc-classifier:${BRICK_CC_TAG:-latest}
    container_name: {{projectName}}-classifier
    command: ["--device", "auto"]
    environment:
      BRICK_CLASSIFIER_TOKEN: ${BRICK_CLASSIFIER_TOKEN:?missing}
    volumes:
      - brick-models:/root/.cache/huggingface
    restart: unless-stopped
{{/if}}
  {{projectName}}:
    image: {{image}}
    container_name: {{projectName}}
    ports:
      - "{{port}}:8000"
    volumes:
      - {{configPath}}:/app/config/config.yaml:ro
      - brick-models:/app/models
    env_file:
      - {{envPath}}
{{#if useLocalClassifier}}
    depends_on:
      classifier:
        condition: service_started
{{/if}}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
{{#if useLocalClassifier}}
  classifier:
    image: docker.io/regolo/brick-complexity:latest
    container_name: {{projectName}}-classifier
    environment:
      - BRICK_CLASSIFIER_TOKEN=${BRICK_CLASSIFIER_TOKEN}
    volumes:
      - brick-models:/app/models
    restart: unless-stopped
{{/if}}

volumes:
  brick-models:
