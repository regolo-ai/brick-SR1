# Generated by brick-cli — do not edit by hand. Run `brick claude on` to regenerate.
# Stack: Brick router{{#if useLocalClassifier}} + local complexity classifier sidecar{{else}} (complexity classifier is a remote OpenAI-compatible endpoint, see config.yaml){{/if}}.
services:
{{#if useLocalClassifier}}
  classifier:
    image: ghcr.io/massaindustries/brick-cc-classifier:${BRICK_CC_TAG:-latest}
    container_name: {{projectName}}-classifier
    # Image entrypoint is `python3 server.py --port 8094 --device cuda`; appending
    # `--device auto` overrides it (argparse keeps the last value) so the default
    # profile works out-of-the-box on GPU and CPU-only hosts alike.
    command: ["--device", "auto"]
    environment:
      BRICK_CLASSIFIER_TOKEN: ${BRICK_CLASSIFIER_TOKEN:?missing — re-run brick claude on}
      HF_TOKEN: ${HF_TOKEN:-}
    volumes:
      - {{projectName}}-hf-cache:/root/.cache/huggingface
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:8094/health"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 120s
    restart: unless-stopped
    networks: [{{projectName}}-net]

{{/if}}
  router:
    image: ghcr.io/massaindustries/brick-cc-mymodel:${BRICK_CC_TAG:-latest}
    container_name: {{projectName}}-router
{{#if useLocalClassifier}}
    depends_on:
      classifier:
        condition: service_healthy
{{/if}}
    environment:
      BRICK_CLASSIFIER_TOKEN: ${BRICK_CLASSIFIER_TOKEN:?missing — re-run brick claude on}
    ports:
      - "{{port}}:8000"
    volumes:
      - {{configPath}}:/app/config/config.yaml:ro
    # No healthcheck: the router image ships no curl/wget. `brick claude on`
    # probes http://localhost:{{port}}/health from the host instead.
    restart: unless-stopped
    networks: [{{projectName}}-net]

networks:
  {{projectName}}-net:
    driver: bridge
{{#if useLocalClassifier}}

volumes:
  {{projectName}}-hf-cache:
{{/if}}
