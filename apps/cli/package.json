{
  "name": "@regoloai/brick",
  "version": "3.0.1",
  "description": "Brick — CLI to host the Brick multimodal LLM routing gateway locally (companion to regolo-ai/brick-SR1)",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/regolo-ai/brick-SR1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regolo-ai/brick-SR1.git",
    "directory": "apps/cli"
  },
  "bugs": "https://github.com/regolo-ai/brick-SR1/issues",
  "keywords": [
    "brick",
    "llm",
    "router",
    "spatial-routing",
    "mixture-of-models",
    "regolo",
    "openai-compatible",
    "multimodal"
  ],
  "bin": {
    "brick": "bin/run.js"
  },
  "files": [
    "/bin/run.js",
    "/dist",
    "/templates/*.config.yaml",
    "/assets/modernbert.json",
    "/oclif.manifest.json",
    "/scripts/runtime-install.cjs",
    "/assets/config-schema.json",
    "/assets/pricing.yaml",
    "/runtimes",
    "/NOTICE",
    "/THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "oclif": {
    "bin": "brick",
    "dirname": "brick",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "hooks": {
      "init": "./dist/hooks/init.js"
    },
    "plugins": [
      "@oclif/plugin-warn-if-update-available"
    ],
    "warn-if-update-available": {
      "timeoutInDays": 1,
      "registry": "https://registry.npmjs.org",
      "message": "A new version of @regoloai/brick is available. Run `brick update` to upgrade."
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.cjs && tsc -b --force",
    "dev": "node --loader ts-node/esm bin/dev.js",
    "test": "vitest run && node --test test/runtime-install.cjs",
    "lint": "tsc --noEmit",
    "prepack": "npm run build && oclif manifest",
    "postinstall": "node scripts/runtime-install.cjs"
  },
  "dependencies": {
    "@clack/core": "0.4.2",
    "@clack/prompts": "^0.10.0",
    "@oclif/core": "^4.0.0",
    "@oclif/plugin-warn-if-update-available": "^3.1.68",
    "chalk": "^5.3.0",
    "enquirer": "^2.4.1",
    "execa": "^9.0.0",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.3.2",
    "picocolors": "^1.1.1",
    "react": "^19.2.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0",
    "oclif": "^4",
    "ts-node": "^10.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "20 || >=22"
  }
}
